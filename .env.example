# ============================================================
# አጋዤ Tutoring Platform – Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
# ============================================================

# -----------------------------------------------------------
# Supabase (required)
# Get these from your Supabase project settings → API
# -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key – used only in server-side code (never expose to browser)
# Required for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------
# App URL (required in production)
# Used for generating absolute URLs (e.g. email verification links)
# -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.com

# -----------------------------------------------------------
# Payment – Telebirr (optional until payments are live)
# -----------------------------------------------------------
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_SHORT_CODE=your-telebirr-short-code
TELEBIRR_PUBLIC_KEY=your-telebirr-public-key
# Webhook secret used to verify Telebirr callback signatures
TELEBIRR_WEBHOOK_SECRET=your-telebirr-webhook-secret

# -----------------------------------------------------------
# Notifications (optional)
# -----------------------------------------------------------
# Firebase Cloud Messaging server key (for push notifications)
FIREBASE_SERVER_KEY=your-firebase-server-key

# Ethiopian SMS gateway credentials
SMS_GATEWAY_API_KEY=your-sms-gateway-key
SMS_GATEWAY_SENDER_ID=Agazhie

# -----------------------------------------------------------
# Contact form webhook (optional)
# Forward contact form submissions to n8n, Zapier, or similar
# -----------------------------------------------------------
CONTACT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact

# -----------------------------------------------------------
# Platform commission rate (percentage, default 20)
# -----------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=20

